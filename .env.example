# AXP CRM (Supabase) — server-only. Powers the Knowledge Centre and enquiries.
AXP_CRM_URL=https://supabase.axpcrm.cloud
AXP_CRM_ANON_KEY=replace-with-the-crm-anon-key

# HomeReady sign-up (/register) -- server-only. See README "HomeReady sign-up".
# Leads database via Supabase's SESSION pooler (port 5432), INSERT-only role.
LEADS_DB_URL=
# Same database, the website's own website_otp schema (pending codes, rate limits).
HOMEREADY_STORE_DB_URL=
# 32+ random bytes, e.g. `openssl rand -hex 32`.
HOMEREADY_OTP_SECRET=
# SendByte, for emailing the one-time code. sk_test_ keys deliver nothing.
SENDBYTE_API_KEY=
SENDBYTE_FROM=
# Optional: Supabase database CA (PEM) to verify the server certificate.
SUPABASE_DB_CA_CERT=

# Home-ownership listings feed (separate platform API).
VITE_LISTINGS_API_BASE_URL=http://localhost:3000

# Optional: point the site at a deployed API instead of its own /api.
# VITE_API_BASE_URL=https://www.axpafrica.com
